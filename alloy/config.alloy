prometheus.relabel "cadvisor" {
  forward_to = [prometheus.remote_write.default.receiver]

  rule {
    action       = "replace"
    target_label = "job"
    replacement  = "cadvisor"
  }
}

prometheus.scrape "cadvisor" {
  targets = [
    {
      __address__   = "192.168.0.145:8050",
      instance      = "192.168.0.145:8050",
      proxmox_guest = "lab-pgdb",
    },
    {
      __address__   = "192.168.1.16:8050",
      instance      = "192.168.1.16:8050",
      proxmox_guest = "prod-apps",
    },
    {
      __address__   = "192.168.1.245:8050",
      instance      = "192.168.1.245:8050",
      proxmox_guest = "ark",
    },
    {
      __address__   = "cadvisor:8080",
      instance      = "cadvisor:8080",
      proxmox_guest = "monitoring-stack",
    },
  ]
  forward_to      = [prometheus.relabel.cadvisor.receiver]
  scrape_interval = "10s"
}

// HTTP health-check probes via the built-in blackbox exporter.
// Emits probe_success (1/0), probe_duration_seconds, probe_http_status_code, etc.
prometheus.exporter.blackbox "health" {
  config = "modules:\n" +
           "  http_2xx:\n" +
           "    prober: http\n" +
           "    timeout: 5s\n" +
           "    http:\n" +
           "      preferred_ip_protocol: ip4\n"

  target {
    name    = "zinohub"
    address = "http://192.168.0.33:7042/health"
    module  = "http_2xx"
  }

  target {
    name    = "webhook-broker"
    address = "http://192.168.2.10:8081/health"
    module  = "http_2xx"
  }

  target {
    name    = "zino-downloader"
    address = "http://192.168.2.10:8082/healthz"
    module  = "http_2xx"
  }
}

prometheus.scrape "health_checks" {
  targets         = prometheus.exporter.blackbox.health.targets
  forward_to      = [prometheus.remote_write.default.receiver]
  scrape_interval = "15s"
}

// Host and container logs

// Docker container logs
loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = []
  forward_to = [loki.process.containers.receiver]
}

loki.process "containers" {
  stage.json {
    expressions = {
      trace_id    = "trace_id",
      span_id     = "span_id",
      level       = "level",
      message     = "message",
    }
  }
  
  stage.labels {
    values = {
      trace_id = "",
      level    = "",
    }
  }

  forward_to = [loki.write.default.receiver]
}

// Local system logs
loki.source.file "system_logs" {
  targets = [
    {__path__ = "/var/log/syslog", job = "syslog"},
    {__path__ = "/var/log/kern.log", job = "kern"},
  ]
  forward_to = [loki.write.default.receiver]
}

loki.source.syslog "external_nginx" {
  listener {
    address       = "0.0.0.0:1514"
    protocol      = "udp"
    syslog_format = "rfc3164"
  }

  forward_to = [loki.process.external_nginx.receiver]
}

loki.process "external_nginx" {
  stage.static_labels {
    values = {
      job  = "nginx",
      host = "external-proxy",
    }
  }

  forward_to = [loki.write.default.receiver]
}

loki.source.syslog "turnkey_nginx" {
  listener {
    address       = "0.0.0.0:1515"
    protocol      = "udp"
    syslog_format = "rfc3164"
  }

  forward_to = [loki.process.turnkey_nginx.receiver]
}

loki.process "turnkey_nginx" {
  stage.static_labels {
    values = {
      job  = "nginx",
      host = "gitea-turnkey",
    }
  }

  forward_to = [loki.write.default.receiver]
}
