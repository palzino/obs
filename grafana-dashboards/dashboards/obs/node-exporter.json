{
  "uid": "obs-node-exporter",
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "obs-node-exporter"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true,
          "legacyOptions": {
            "type": "dashboard"
          }
        }
      }
    ],
    "cursorSync": "Crosshair",
    "description": "Lightweight Node Exporter dashboard for hosts scraped via Alloy (prometheus.scrape.node_exporter). Deployed via Terraform from the obs repo. nino-dev includes the former dev-box-vm series so the rename stays one line. The scrape key is Alloy's instance label, not the Proxmox vmid or the OS hostname.",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Scrape status",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "label_replace(label_replace(up{job=\"prometheus.scrape.node_exporter\", instance=~\"${instance:pipe}\"}, \"instance\", \"nino-dev\", \"instance\", \"dev-box-vm\"), \"proxmox_guest\", \"nino-dev\", \"proxmox_guest\", \"dev-box-vm\")",
                        "legendFormat": "{{instance}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.4",
            "spec": {
              "options": {
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "textMode": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "none",
                  "mappings": [
                    {
                      "type": "value",
                      "options": {
                        "0": {
                          "text": "DOWN",
                          "color": "red",
                          "index": 0
                        }
                      }
                    },
                    {
                      "type": "value",
                      "options": {
                        "1": {
                          "text": "UP",
                          "color": "green",
                          "index": 1
                        }
                      }
                    }
                  ],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "red"
                      },
                      {
                        "value": 1,
                        "color": "green"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-10": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Filesystem usage",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "label_replace(label_replace(100 * (1 - node_filesystem_avail_bytes{job=\"prometheus.scrape.node_exporter\", instance=~\"${instance:pipe}\", fstype!~\"tmpfs|overlay|squashfs|aufs|rootfs\", mountpoint!~\"/run.*|/var/lib/docker.*|/var/lib/kubelet.*\"} / node_filesystem_size_bytes{job=\"prometheus.scrape.node_exporter\", instance=~\"${instance:pipe}\", fstype!~\"tmpfs|overlay|squashfs|aufs|rootfs\", mountpoint!~\"/run.*|/var/lib/docker.*|/var/lib/kubelet.*\"}), \"instance\", \"nino-dev\", \"instance\", \"dev-box-vm\"), \"proxmox_guest\", \"nino-dev\", \"proxmox_guest\", \"dev-box-vm\")",
                        "legendFormat": "{{instance}} {{mountpoint}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "bargauge",
            "version": "13.2.4",
            "spec": {
              "options": {
                "displayMode": "gradient",
                "minVizHeight": 10,
                "minVizWidth": 0,
                "namePlacement": "auto",
                "orientation": "horizontal",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showUnfilled": true,
                "valueMode": "color"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percent",
                  "decimals": 1,
                  "min": 0,
                  "max": 100,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      },
                      {
                        "value": 80,
                        "color": "yellow"
                      },
                      {
                        "value": 90,
                        "color": "red"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "CPU",
          "links": [],
