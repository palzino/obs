      "panel-9": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "Container summary",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum(rate(container_cpu_usage_seconds_total{job=\"cadvisor\", instance=~\"$instance\", name=~\"$container\", name=~\".+\"}[$__rate_interval])) by (name) * 100",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "__auto"
                      }
                    },
                    "refId": "cpu",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "sum(container_memory_rss{job=\"cadvisor\", instance=~\"$instance\", name=~\"$container\", name=~\".+\"}) by (name)",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "__auto"
                      }
                    },
                    "refId": "mem",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "expr": "max by (name) ((time() - container_start_time_seconds{job=\"cadvisor\", instance=~\"$instance\", name=~\"$container\", name=~\".+\"}) / 86400)",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "__auto"
                      }
                    },
                    "refId": "uptime",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "seriesToColumns",
                  "spec": {
                    "options": {
                      "byField": "name"
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Time": true,
                        "Time 1": true,
                        "Time 2": true,
                        "Time 3": true
                      },
                      "indexByName": {},
                      "renameByName": {
                        "Value #cpu": "CPU %",
                        "Value #mem": "Memory",
                        "Value #uptime": "Uptime",
                        "name": "Container"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.2.4",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "footer": {
                  "countRows": false,
                  "fields": "",
                  "reducer": [
                    "sum"
                  ],
                  "show": false
                },
                "showHeader": true,
                "sortBy": [
                  {
                    "desc": true,
                    "displayName": "CPU %"
                  }
                ]
              },
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  },
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "inspect": false
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "CPU %"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "percent"
                      },
                      {
                        "id": "decimals",
                        "value": 1
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Memory"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "bytes"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Uptime"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "d"
                      },
                      {
                        "id": "decimals",
                        "value": 1
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
