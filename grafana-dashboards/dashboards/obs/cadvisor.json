      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Scrape status",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
