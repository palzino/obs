            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "tempo",
                      "version": "v0",
                      "datasource": {
                        "name": "tempo"
                      },
                      "spec": {
                        "limit": 20,
                        "query": "{ resource.service.name =~ \"$service\" && resource.deployment.environment.name =~ \"$environment\" }",
                        "queryType": "traceql",
                        "tableType": "traces"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "traces",
            "version": "13.2.4",
            "spec": {
              "options": {},
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      },
      "panel-14": {
        "kind": "Panel",
        "spec": {
          "id": 14,
          "title": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
