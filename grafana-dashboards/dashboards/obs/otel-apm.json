                "content": "Managed by **Terraform CI** from `obs/grafana-dashboards`. Deployment test marker.",
                "mode": "markdown"
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          },
          "transparent": true
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Server error rate",
