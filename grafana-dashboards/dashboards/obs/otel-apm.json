          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=~\"$service\", deployment_environment_name=~\"$environment\", http_response_status_code=~\"5..\"}[$__rate_interval])) / sum(rate(http_server_request_duration_seconds_count{job=~\"$service\", deployment_environment_name=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "5xx rate",
          "refId": "A"
