                "textMode": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percentunit",
                  "decimals": 2,
                  "min": 0,
                  "max": 1,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
