          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "up"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 - (avg by (instance, proxmox_guest) (rate(node_cpu_seconds_total{job=\"prometheus.scrape.node_exporter\", mode=\"idle\"}[5m])) * 100)",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "cpu"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"prometheus.scrape.node_exporter\"} / node_memory_MemTotal_bytes{job=\"prometheus.scrape.node_exporter\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "mem"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"prometheus.scrape.node_exporter\", mountpoint=\"/\", fstype!~\"tmpfs|overlay|squashfs|aufs|rootfs\"} / node_filesystem_size_bytes{job=\"prometheus.scrape.node_exporter\", mountpoint=\"/\", fstype!~\"tmpfs|overlay|squashfs|aufs|rootfs\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "disk"
        }
      ],
      "title": "Hosts",
      "transformations": [
        { "id": "seriesToColumns", "options": { "byField": "instance" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "job": true,
              "job 1": true,
              "job 2": true,
              "job 3": true,
              "proxmox_guest 2": true,
              "proxmox_guest 3": true,
              "proxmox_guest 4": true
            },
            "renameByName": {
              "Value #cpu": "CPU %",
              "Value #disk": "Root disk %",
              "Value #mem": "Memory %",
              "Value #up": "Status",
              "instance": "Host",
              "proxmox_guest": "Guest",
              "proxmox_guest 1": "Guest"
            }
          }
        }
      ],
      "type": "table"
    },
