          "mappings": [
            { "options": { "0": { "color": "red", "index": 0, "text": "stopped" } }, "type": "value" },
            { "options": { "1": { "color": "green", "index": 1, "text": "running" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
